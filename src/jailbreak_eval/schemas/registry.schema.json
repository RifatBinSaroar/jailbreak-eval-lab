{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jailbreak-eval:registry:1.0.0",
  "title": "Research registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry": {
      "enum": [
        "papers",
        "benchmarks",
        "domains",
        "validators",
        "datasets",
        "experiments",
        "runs",
        "human_labels",
        "results"
      ]
    },
    "records": {
      "type": "array"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "registry": {
            "const": "papers"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/paper"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registry": {
            "const": "benchmarks"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/benchmark"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registry": {
            "const": "domains"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/domain"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registry": {
            "const": "validators"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/validator"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registry": {
            "const": "datasets"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/dataset"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registry": {
            "const": "experiments"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/experiment"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registry": {
            "const": "runs"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/run"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registry": {
            "const": "human_labels"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/human_label"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registry": {
            "const": "results"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/result"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uri",
        "sha256",
        "media_type",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "locator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "config"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "config": {
          "$ref": "#/$defs/config"
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "artifact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicted_success",
        "functional_stage",
        "dimensions",
        "score",
        "confidence",
        "reason"
      ],
      "properties": {
        "predicted_success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "functional_stage": {
          "enum": [
            null,
            "F0",
            "F1",
            "F2",
            "F3",
            "F4",
            "F5",
            "FX"
          ]
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "R",
            "H",
            "F",
            "Q",
            "E"
          ],
          "properties": {
            "R": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "H": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "F": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "Q": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "E": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "upstream_version",
        "license",
        "retrieved_at",
        "redistribution",
        "transformations"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "upstream_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "redistribution": {
          "enum": [
            "permitted",
            "prohibited",
            "unknown"
          ]
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "code_commit"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "code_commit": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_kind",
        "version",
        "timestamp",
        "notes",
        "title",
        "year",
        "venue_or_identifier",
        "sources",
        "evidence_status",
        "benchmark_ids",
        "domain_ids",
        "validator_ids",
        "paper_demonstrates",
        "our_interpretation",
        "open_questions",
        "novelty"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^paper:[a-z0-9][a-z0-9._-]*$"
        },
        "record_kind": {
          "enum": [
            "research",
            "template"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2200
            },
            {
              "type": "null"
            }
          ]
        },
        "venue_or_identifier": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence_status": {
          "enum": [
            "listed",
            "screened",
            "deep-reviewed",
            "verified"
          ]
        },
        "benchmark_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "domain_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "validator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "paper_demonstrates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "topic",
              "claim",
              "source_id",
              "locator",
              "verification_status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
              },
              "topic": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "claim": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "verification_status": {
                "enum": [
                  "unverified",
                  "verified"
                ]
              }
            }
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "our_interpretation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "evidence_ids"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
                },
                "minItems": 0,
                "uniqueItems": true
              }
            }
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "novelty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "basis",
            "rationale",
            "evidence_ids"
          ],
          "properties": {
            "status": {
              "enum": [
                "unassessed",
                "under_review",
                "prior_work_overlap"
              ]
            },
            "basis": {
              "const": "manual_evidence_review"
            },
            "rationale": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
              },
              "minItems": 0,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_kind",
        "version",
        "timestamp",
        "notes",
        "name",
        "description",
        "domain_ids",
        "paper_ids",
        "provenance",
        "manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^benchmark:[a-z0-9][a-z0-9._-]*$"
        },
        "record_kind": {
          "enum": [
            "research",
            "template"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "domain_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "paper_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "provenance": {
          "$ref": "#/$defs/data_provenance"
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_kind",
        "version",
        "timestamp",
        "notes",
        "name",
        "level",
        "parent_id",
        "definition",
        "inclusion_criteria",
        "exclusion_criteria",
        "status",
        "paper_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:domain|subdomain):[a-z0-9][a-z0-9._-]*$"
        },
        "record_kind": {
          "enum": [
            "research",
            "template"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "level": {
          "enum": [
            "domain",
            "subdomain"
          ]
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9._-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "inclusion_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "exclusion_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "candidate",
            "selected",
            "retired"
          ]
        },
        "paper_ids": {
          "type": "array",
